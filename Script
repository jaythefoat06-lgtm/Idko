-- [[ SLIDER FUNCTION ]] --
local function AddSlider(name, y, min, max, default, var)
    local F = Instance.new("Frame", Main)
    F.Size = UDim2.new(0.9, 0, 0, 45)
    F.Position = UDim2.new(0.05, 0, 0, y)
    F.BackgroundTransparency = 1
    
    local L = Instance.new("TextLabel", F)
    L.Text = name .. ": " .. default
    L.Size = UDim2.new(1, 0, 0, 20)
    L.TextColor3 = Color3.fromRGB(255, 255, 255)
    L.BackgroundTransparency = 1
    L.Font = Enum.Font.Gotham
    L.TextSize = 14

    local BG = Instance.new("Frame", F)
    BG.Size = UDim2.new(1, 0, 0, 6)
    BG.Position = UDim2.new(0, 0, 1, -10)
    BG.BackgroundColor3 = Color3.fromRGB(60, 20, 60)
    Instance.new("UICorner", BG)

    local Fill = Instance.new("Frame", BG)
    Fill.Size = UDim2.new((default - min)/(max - min), 0, 1, 0)
    Fill.BackgroundColor3 = Color3.fromRGB(255, 20, 147)
    Instance.new("UICorner", Fill)

    local function Update(input)
        local pos = math.clamp((input.Position.X - BG.AbsolutePosition.X) / BG.AbsoluteSize.X, 0, 1)
        Fill.Size = UDim2.new(pos, 0, 1, 0)
        local val = math.floor(min + (pos * (max - min)))
        L.Text = name .. ": " .. val
        _G.Settings[var] = val
    end

    BG.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            Update(input)
            local move = UIS.InputChanged:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseMovement then Update(input) end
            end)
            local release; release = UIS.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    move:Disconnect()
                    release:Disconnect()
                end
            end)
        end
    end)
end

