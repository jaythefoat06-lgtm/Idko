-- [[ FUNCTIONALITY BUTTONS ]] --
_G.Settings = { Speed = 50, Spin = false, InfJump = false, AntiKB = false, AutoGrab = false, Freeze = false }

local function AddToggle(name, y, var)
    local F = Instance.new("Frame", Main)
    F.Size = UDim2.new(0.9, 0, 0, 40)
    F.Position = UDim2.new(0.05, 0, 0, y)
    F.BackgroundTransparency = 1
    
    local L = Instance.new("TextLabel", F)
    L.Text = name
    L.Size = UDim2.new(0.5, 0, 1, 0)
    L.TextColor3 = Color3.new(0.8, 0.8, 0.8)
    L.BackgroundTransparency = 1
    L.TextXAlignment = Enum.TextXAlignment.Left
    L.Font = Enum.Font.Gotham
    L.TextSize = 16

    local B = Instance.new("TextButton", F)
    B.Size = UDim2.new(0, 50, 0, 25)
    B.Position = UDim2.new(1, -60, 0.5, -12)
    B.BackgroundColor3 = Color3.fromRGB(60, 20, 60)
    B.Text = ""
    local BC = Instance.new("UICorner", B)
    BC.CornerRadius = UDim.new(1, 0)
    
    local Dot = Instance.new("Frame", B)
    Dot.Size = UDim2.new(0, 18, 0, 18)
    Dot.Position = UDim2.new(0, 4, 0.5, -9)
    Dot.BackgroundColor3 = Color3.new(1, 1, 1)
    Instance.new("UICorner", Dot).CornerRadius = UDim.new(1, 0)

    B.MouseButton1Click:Connect(function()
        _G.Settings[var] = not _G.Settings[var]
        B.BackgroundColor3 = _G.Settings[var] and Color3.fromRGB(180, 50, 255) or Color3.fromRGB(60, 20, 60)
        Dot:TweenPosition(_G.Settings[var] and UDim2.new(1, -22, 0.5, -9) or UDim2.new(0, 4, 0.5, -9), "Out", "Quad", 0.2)
    end)
end

-- Alignment based on your image
