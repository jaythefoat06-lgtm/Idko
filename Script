-- Create the UI
local ScreenGui = Instance.new("ScreenGui")
local MainButton = Instance.new("TextButton")
local status = false -- The toggle state

-- Properties
ScreenGui.Parent = game.CoreGui -- Places it over the game UI
MainButton.Parent = ScreenGui
MainButton.Size = UDim2.new(0, 150, 0, 50)
MainButton.Position = UDim2.new(0.5, -75, 0.1, 0) -- Top center
MainButton.Text = "Auto Pickup: OFF"
MainButton.BackgroundColor3 = Color3.fromRGB(200, 0, 0) -- Red

-- Auto Pickup Logic
local function startPickup()
    local player = game.Players.LocalPlayer
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    
    if root and status then
        for _, item in ipairs(workspace:GetChildren()) do
            if item:IsA("BasePart") and (root.Position - item.Position).Magnitude < 25 then
                item.CFrame = root.CFrame
            end
        end
    end
end

-- Toggle Function
MainButton.MouseButton1Click:Connect(function()
    status = not status
    if status then
        MainButton.Text = "Auto Pickup: ON"
        MainButton.BackgroundColor3 = Color3.fromRGB(0, 200, 0) -- Green
    else
        MainButton.Text = "Auto Pickup: OFF"
        MainButton.BackgroundColor3 = Color3.fromRGB(200, 0, 0) -- Red
    end
end)

-- Run the check every 0.1 seconds
spawn(function()
    while true do
        task.wait(0.1)
        if status then
            startPickup()
        end
    end
end)
