-- [[ LOGIC ]] --
RS.Heartbeat:Connect(function()
    local Char = LP.Character
    local Hum = Char and Char:FindFirstChildOfClass("Humanoid")
    local Root = Char and Char:FindFirstChild("HumanoidRootPart")

    if Hum and Root then
        -- FIXED SPEED
        Hum.WalkSpeed = _G.Settings.SpeedActive and _G.Settings.WalkSpeed or 16
        
        -- FIXED PHYSICAL SPIN (Body Force)
        if _G.Settings.SpinActive then
            local SpinForce = Root:FindFirstChild("8Hub_PhysicsSpin") or Instance.new("BodyAngularVelocity", Root)
            SpinForce.Name = "8Hub_PhysicsSpin"
            SpinForce.MaxTorque = Vector3.new(0, math.huge, 0)
            SpinForce.AngularVelocity = Vector3.new(0, _G.Settings.SpinSpeed, 0)
        elseif Root:FindFirstChild("8Hub_PhysicsSpin") then
            Root:FindFirstChild("8Hub_PhysicsSpin"):Destroy()
        end

        -- ANTI-KB
        if _G.Settings.AntiKB then
            Root.Velocity = Vector3.new(0, Root.Velocity.Y, 0)
        end
    end

    -- AUTO-GRAB
    if _G.Settings.AutoGrab and Root then
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("TouchTransmitter") and (Root.Position - v.Parent.Position).Magnitude <= 15 then
                firetouchinterest(Root, v.Parent, 0)
                firetouchinterest(Root, v.Parent, 1)
            end
        end
    end
end)

