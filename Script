-- [[ TOGGLE COMPONENT ]]
local function CreateToggle(text, pos, varName)
    local btn = Instance.new("TextButton", MainFrame)
    btn.Size = UDim2.new(0.4, 0, 0, 35)
    btn.Position = pos
    btn.Text = text .. ": OFF"
    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 11
    Instance.new("UICorner", btn)

    btn.MouseButton1Click:Connect(function()
        state[varName] = not state[varName]
        btn.Text = text .. (state[varName] and ": ON" or ": OFF")
        btn.BackgroundColor3 = state[varName] and Color3.fromRGB(80, 0, 200) or Color3.fromRGB(40, 40, 45)
    end)
end

