-- Debug console
local function debugLog(...)
    if DEBUG_MODE then
        print("[Brainrot Fishing]", ...)
    end
end

-- Better UI detection
local function findAllInteractiveButtons()
    local buttons = {}
    
    -- Search through all GUIs
    local function searchGUI(gui)
        for _, child in pairs(gui:GetChildren()) do
            if child:IsA("TextButton") or child:IsA("ImageButton") then
                if child.Visible and child.Active then
                    table.insert(buttons, child)
                    debugLog("Found button:", child.Name, "Text:", child.Text, "Parent:", child.Parent.Name)
                end
            end
            if #child:GetChildren() > 0 then
                searchGUI(child)
            end
        end
    end
    
    -- Search through all player GUIs
    for _, gui in pairs(player.PlayerGui:GetChildren()) do
        searchGUI(gui)
    end
    
    return buttons
end

-- Find cast button with multiple detection methods
local function findCastButton()
    local allButtons = findAllInteractiveButtons()
    
    for _, btn in pairs(allButtons) do
        local btnText = (btn.Text or ""):lower()
        local btnName = (btn.Name or ""):lower()
        
        -- Check for fishing-related keywords
        if btnText:find("cast") or btnText:find("fish") or btnText:find("throw") or 
           btnText:find("start") or btnText:find("bait") or
           btnName:find("cast") or btnName:find("fish") or btnName:find("throw") then
            debugLog("Cast button found:", btn.Name, btn.Text)
            return btn
        end
    end
    
    return nil
end

-- Find reel/catch button
local function findReelButton()
    local allButtons = findAllInteractiveButtons()
    
    for _, btn in pairs(allButtons) do
        local btnText = (btn.Text or ""):lower()
        local btnName = (btn.Name or ""):lower()
        
        -- Check for reel-related keywords
        if btnText:find("reel") or btnText:find("catch") or btnText:find("pull") or 
           btnText:find("click") or btnText:find("tap") or btnText:find("stop") or
           btnName:find("reel") or btnName:find("catch") or btnName:find("pull") then
            debugLog("Reel button found:", btn.Name, btn.Text)
            return btn
        end
    end
    
    return nil
end

-- Find perfect zone or progress bar
local function findPerfectZone()
    -- Search for progress bars or zones
    local function searchForZone(gui)
        for _, child in pairs(gui:GetChildren()) do
            -- Look for frames that might be progress bars
            if child:IsA("Frame") and child.Size.X.Scale > 0.5 then
                -- Check if it's a progress bar
                for _, grandchild in pairs(child:GetChildren()) do
                    if grandchild:IsA("Frame") and grandchild.Size.X.Scale < 1 then
                        debugLog("Possible progress bar found:", child.Name)
                        return child
                    end
                end
            end
            
            -- Look for perfect zone indicators
            if child.Name:lower():find("perfect") or child.Name:lower():find("zone") or
               child.Name:lower():find("sweet") or child.Name:lower():find("spot") then
                debugLog("Perfect zone found:", child.Name)
                return child
            end
            
            if #child:GetChildren() > 0 then
                local result = searchForZone(child)
                if result then return result end
            end
        end
        return nil
    end
    
    for _, gui in pairs(player.PlayerGui:GetChildren()) do
        local result = searchForZone(gui)
        if result then return result end
    end
    
    return nil
end

-- Simulate click (works for both mobile and PC)
local function clickButton(button)
    if not button or not button.Parent then return false end
    
    debugLog("Clicking button:", button.Name, button.Text)
    
    -- Try different click methods
    local success = false
    
    -- Method 1: Fire click event
    pcall(function()
        button:Click()
        success = true
    end)
    
    -- Method 2: Fire MouseButton1Click
    if not success then
        pcall(function()
            button:Fire("MouseButton1Click")
            success = true
        end)
    end
    
    -- Method 3: Fire Activate
    if not success then
        pcall(function()
            button:Fire("Activate")
            success = true
        end)
    end
    
    -- Method 4: Use VirtualUser for mobile
    if not success and isMobile then
        pcall(function()
            VirtualUser:ClickButton(button)
            success = true
        end)
    end
    
    return success
end

-- Cast fishing line
local function castLine()
    if isFishing or isCatching or isReeling then 
        debugLog("Cannot cast - already fishing/reeling")
        return false 
    end
    
    local castBtn = findCastButton()
    if castBtn and castBtn.Parent then
        local success = clickButton(castBtn)
        if success then
            isFishing = true
            createNotification("🎣 CASTING LINE...", Color3.fromRGB(100, 200, 255))
            debugLog("Cast successful")
            return true
        end
    else
        debugLog("No cast button found")
    end
    return false
end

-- Auto reel function
local function reelFish()
    if not settings.autoReel then return false end
    if isReeling then return false end
    
    local reelBtn = findReelButton()
    if reelBtn and reelBtn.Parent then
        local success = clickButton(reelBtn)
        if success then
            isReeling = true
            createNotification("🎣 REELING FISH!", Color3.fromRGB(100, 255, 100))
            debugLog("Reel successful")
            
            -- Reset states after delay
            task.spawn(function()
                task.wait(1)
                isReeling = false
                isCatching = false
                isFishing = false
                currentFishBite = false
            end)
            return true
        end
    else
        debugLog("No reel button found")
    end
    return false
end

-- Auto perfect function
local function perfectCatch()
    if not settings.autoPerfect then return false end
    
    local perfectZone = findPerfectZone()
    if perfectZone then
        -- Click on the perfect zone
        clickButton(perfectZone)
        debugLog("Perfect catch attempted")
        createNotification("✨ PERFECT CATCH!", Color3.fromRGB(255, 200, 100))
        return true
    end
    
    -- Alternative: Click on the main catch button if no perfect zone found
    local reelBtn = findReelButton()
    if reelBtn then
        clickButton(reelBtn)
        debugLog("Perfect catch via reel button")
        return true
    end
    
    return false
end

-- Auto fishing loop
local autoFishingTask = nil

local function autoCastLoop()
    while settings.autoFish and task.wait(0.5) do
        local currentTime = tick()
        
        if not isFishing and not isCatching and not isReeling then
            if currentTime - lastCastTime >= settings.castDelay then
                castLine()
                lastCastTime = currentTime
            end
        end
    end
end

local function startAutoFishing()
    if autoFishingTask then
        task.cancel(autoFishingTask)
    end
    autoFishingTask = task.spawn(autoCastLoop)
end

-- Monitor for UI changes (better detection)
local function monitorUIChanges()
    -- Track when new UI appears
    local connection = player.PlayerGui.DescendantAdded:Connect(function(descendant)
        if descendant:IsA("TextButton") or descendant:IsA("ImageButton") then
            local btnText = (descendant.Text or ""):lower()
            local btnName = (descendant.Name or ""):lower()
            
            -- Detect catch/reel UI appearing
            if btnText:find("catch") or btnText:find("reel") or btnText:find("tap") or
               btnName:find("catch") or btnName:find("reel") then
                debugLog("Catch UI detected!")
                isCatching = true
                isFishing = false
                currentFishBite = true
                
                -- Auto perfect
                if settings.autoPerfect then
                    task.spawn(function()
                        task.wait(0.1)
                        perfectCatch()
                    end)
                end
                
                -- Auto reel
                if settings.autoReel then
                    task.spawn(function()
                        task.wait(0.2)
                        reelFish()
                    end)
                end
            end
            
            -- Detect cast button
            if btnText:find("cast") or btnText:find("fish") or btnName:find("cast") then
                debugLog("Cast button detected in UI")
            end
        end
        
        -- Detect frames that might be progress bars
        if descendant:IsA("Frame") and descendant.Size.X.Scale > 0.5 then
            debugLog("Large frame detected:", descendant.Name)
            if descendant.Parent and descendant.Parent:FindFirstChildWhichIsA("TextButton") then
                debugLog("Possible fishing UI detected")
            end
        end
    end)
    
    -- Track when UI is removed
    player.PlayerGui.DescendantRemoving:Connect(function(descendant)
        if descendant:IsA("TextButton") or descendant:IsA("ImageButton") then
            local btnText = (descendant.Text or ""):lower()
            if btnText:find("catch") or btnText:find("reel") then
                debugLog("Catch UI removed")
                task.wait(0.3)
                isCatching = false
                isReeling = false
                isFishing = false
            end
        end
    end)
    
    return connection
end

