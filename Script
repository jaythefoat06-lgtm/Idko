    btnCorner4.CornerRadius = UDim.new(0, 8)
    btnCorner4.Parent = closeBtn
    
    -- Update button texts
    local function updateButtons()
        autoFishBtn.Text = settings.autoFish and "🔁 AUTO FISH: ON 🔥" or "🔁 AUTO FISH: OFF"
        autoFishBtn.BackgroundColor3 = settings.autoFish and Color3.fromRGB(80, 120, 80) or Color3.fromRGB(40, 40, 50)
        autoPerfectBtn.Text = settings.autoPerfect and "✨ AUTO PERFECT: ON 💯" or "✨ AUTO PERFECT: OFF"
        autoPerfectBtn.BackgroundColor3 = settings.autoPerfect and Color3.fromRGB(80, 120, 80) or Color3.fromRGB(40, 40, 50)
    end
    
    -- Slider dragging
    local dragging = false
    sliderButton.MouseButton1Down:Connect(function()
        dragging = true
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    local function updateDelay(value)
        settings.castDelay = math.clamp(value, 0.5, 5)
        delayLabel.Text = string.format("CAST DELAY: %.1fs", settings.castDelay)
        local percent = (settings.castDelay - 0.5) / 4.5
        sliderFill.Size = UDim2.new(percent, 0, 1, 0)
        sliderButton.Position = UDim2.new(percent, -10, 0.5, -10)
    end
    
    updateDelay(settings.castDelay)
    
    RunService.RenderStepped:Connect(function()
        if dragging then
            local mousePos = mouse.X
            local sliderPos = sliderBg.AbsolutePosition.X
            local sliderWidth = sliderBg.AbsoluteSize.X
            local percent = math.clamp((mousePos - sliderPos) / sliderWidth, 0, 1)
            settings.castDelay = 0.5 + (percent * 4.5)
            updateDelay(settings.castDelay)
        end
    end)
    
    -- Button connections
    autoFishBtn.MouseButton1Click:Connect(function()
        settings.autoFish = not settings.autoFish
        updateButtons()
        if settings.autoFish then
            startAutoFishing()
        end
    end)
    
    autoPerfectBtn.MouseButton1Click:Connect(function()
        settings.autoPerfect = not settings.autoPerfect
        updateButtons()
    end)
    
    closeBtn.MouseButton1Click:Connect(function()
        toggleMenu()
    end)
    
    updateButtons()
    
    -- Animate menu
    local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local openTween = TweenService:Create(menuFrame, tweenInfo, {BackgroundTransparency = 0, Position = UDim2.new(0.5, -150, 0.5, -125)})
    local closeTween = TweenService:Create(menuFrame, tweenInfo, {BackgroundTransparency = 1, Position = UDim2.new(0.5, -150, 0.5, -100)})
    
    local function setMenuVisible(visible)
        menuVisible = visible
        menuFrame.Visible = true
        if visible then
            openTween:Play()
        else
            closeTween:Play()
            closeTween.Completed:Wait()
            menuFrame.Visible = false
        end
    end
    
    return setMenuVisible
end

-- Auto fishing logic
local autoFishingTask = nil

local function findCastButton()
    -- Look for common fishing UI elements
    local screenGui = player.PlayerGui:FindFirstChild("FishingGUI") or player.PlayerGui:FindFirstChild("Fishing")
    if screenGui then
        local castBtn = screenGui:FindFirstChild("CastButton") or screenGui:FindFirstChild("FishButton")
        if castBtn and castBtn:IsA("TextButton") then
            return castBtn
        end
    end
    
    -- Alternative: find by text
    for _, gui in pairs(player.PlayerGui:GetChildren()) do
        local btn = gui:FindFirstChild("CastButton") or gui:FindFirstChild("Fish")
        if btn and btn:IsA("TextButton") and btn.Visible then
            return btn
        end
    end
    
    return nil
end

local function castLine()
    local castBtn = findCastButton()
    if castBtn and castBtn.Visible then
        castBtn:Click()
        isFishing = true
        return true
    end
    return false
end

local function autoCastLoop()
    while settings.autoFish and task.wait(settings.castDelay) do
        if not isFishing and not isCatching then
            castLine()
        end
    end
end

local function startAutoFishing()
    if autoFishingTask then
        task.cancel(autoFishingTask)
    end
    autoFishingTask = task.spawn(autoCastLoop)
end

-- Auto perfect catching
local function findCatchUI()
    -- Look for the catching minigame UI
    for _, gui in pairs(player.PlayerGui:GetDescendants()) do
        if gui.Name:lower():find("catch") or gui.Name:lower():find("reel") then
            if gui:IsA("Frame") and gui.Visible then
                return gui
            end
        end
    end
    return nil
end

local function findPerfectZone()
    -- Find the perfect zone indicator
    local catchUI = findCatchUI()
    if catchUI then
        for _, child in pairs(catchUI:GetDescendants()) do
            if child.Name:lower():find("perfect") or child.Name:lower():find("zone") then
                return child
            end
        end
    end
    return nil
end

local function findCatchButton()
    -- Find the button to catch/reel
    for _, gui in pairs(player.PlayerGui:GetDescendants()) do
        if gui:IsA("TextButton") and (gui.Text:lower():find("catch") or gui.Text:lower():find("reel")) then
            return gui
        end
    end
    return nil
end

-- Hook into catching events
local function setupCatchDetection()
    -- Monitor for new UI elements appearing
    local connection
    connection = player.PlayerGui.DescendantAdded:Connect(function(descendant)
        if descendant:IsA("Frame") and (descendant.Name:lower():find("catch") or descendant.Name:lower():find("reel")) then
            isCatching = true
            isFishing = false
            
            if settings.autoPerfect then
                task.spawn(function()
                    task.wait(0.05) -- Small delay for UI to fully load
                    local catchBtn = findCatchButton()
                    if catchBtn then
                        catchBtn:Click()
                    end
                end)
            end
        end
    end)
    
    -- Detect when catching is done
    player.PlayerGui.DescendantRemoving:Connect(function(descendant)
        if descendant:IsA("Frame") and (descendant.Name:lower():find("catch") or descendant.Name:lower():find("reel")) then
            isCatching = false
        end
    end)
    
    return connection
end

-- UI Notification system
local function createNotification(text, color)
    local notif = Instance.new("TextLabel")
    notif.Size = UDim2.new(0, 250, 0, 40)
    notif.Position = UDim2.new(0.5, -125, 0.9, 0)
    notif.BackgroundColor3 = color or Color3.fromRGB(50, 50, 50)
    notif.BackgroundTransparency = 0.2
    notif.Text = text
    notif.TextColor3 = Color3.fromRGB(255, 255, 255)
    notif.TextScaled = true
    notif.Font = Enum.Font.GothamBold
    notif.Parent = screenGui
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = notif
    
    local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local fadeOut = TweenService:Create(notif, tweenInfo, {BackgroundTransparency = 1, TextTransparency = 1})
    
    task.wait(2)
    fadeOut:Play()
    fadeOut.Completed:Connect(function()
        notif:Destroy()
    end)
end

-- Toggle menu
local toggleMenu
local function init()
    toggleMenu = createMenu()
    
    -- Menu toggle key (M)
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        
        if input.KeyCode == Enum.KeyCode.M then
            toggleMenu(not menuVisible)
        end
    end)
    
    -- Setup catch detection
    setupCatchDetection()
    
    -- Start watching for fishing state
    task.spawn(function()
        while task.wait(0.5) do
            if settings.autoFish and not isFishing and not isCatching then
                castLine()
            end
        end
    end)
    
    createNotification("🐟 BRAINROT FISHING LOADED | PRESS M", Color3.fromRGB(100, 150, 200))
end

-- Run the script
init()

