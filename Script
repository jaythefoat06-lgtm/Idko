-- [[ GAME LOGIC ]] --
RS.Heartbeat:Connect(function()
    local Char = LP.Character
    local Hum = Char and Char:FindFirstChildOfClass("Humanoid")
    local Root = Char and Char:FindFirstChild("HumanoidRootPart")

    if Hum and Root then
        -- SPEED
        if _G.Settings.SpeedActive then Hum.WalkSpeed = _G.Settings.WalkSpeed else Hum.WalkSpeed = 16 end
        
        -- PHYSICAL SPIN (Bypasses many resets)
        if _G.Settings.SpinActive then
            if not Root:FindFirstChild("8Hub_Spin") then
                local AV = Instance.new("AngularVelocity", Root)
                AV.Name = "8Hub_Spin"
                AV.MaxTorque = math.huge
                AV.Attachment0 = Root:FindFirstChildOfClass("Attachment") or Instance.new("Attachment", Root)
            end
            Root:FindFirstChild("8Hub_Spin").AngularVelocity = Vector3.new(0, _G.Settings.SpinSpeed, 0)
        elseif Root:FindFirstChild("8Hub_Spin") then
            Root:FindFirstChild("8Hub_Spin"):Destroy()
        end

        -- ANIMATION FREEZE
        if _G.Settings.Freeze then
            for _, track in pairs(Hum:GetPlayingAnimationTracks()) do track:AdjustSpeed(0) end
        else
            for _, track in pairs(Hum:GetPlayingAnimationTracks()) do track:AdjustSpeed(1) end
        end

        -- ANTI-KNOCKBACK
        if _G.Settings.AntiKB then
            local v = Root.AssemblyLinearVelocity
            Root.AssemblyLinearVelocity = Vector3.new(0, v.Y, 0)
        end
    end

    -- NEARBY GRABBER
    if _G.Settings.AutoGrab and Root then
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("TouchTransmitter") and (Root.Position - v.Parent.Position).Magnitude <= 12 then
                firetouchinterest(Root, v.Parent, 0)
                firetouchinterest(Root, v.Parent, 1)
            end
        end
    end
end)

