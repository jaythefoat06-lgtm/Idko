local function makeKey(data)
    return tostring(data.name or "") .. "|" .. tostring(data.money or "")
end

local function processEntry(data)
    if not data or not data.money then return end
    
    local moneyValue = parseMoneyValue(data.money)
    if moneyValue < State.MinGenFilter then return end
    
    local key = makeKey(data)
    if not State.Processed[key] then
        State.Processed[key] = true
        local item = {
            nome = data.name or "Unknown Server",
            money = data.money or "$0",
            valor = moneyValue,
            join_script = data.join_script
        }
        
        table.insert(State.Buffer, item)
        table.insert(State.JoinQueue, item)
    end
end

