-- 1. FIX: STEALTH SPEED (Doesn't Kill)
RunService.Stepped:Connect(function(_, deltaTime)
    if isSpeedEnabled and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        local hum = player.Character.Humanoid
        local root = player.Character.HumanoidRootPart
        if hum.MoveDirection.Magnitude > 0 then
            -- We move the CFrame directly by a small amount per frame
            -- This bypasses most "Velocity" based anti-cheats
            root.CFrame = root.CFrame + (hum.MoveDirection * (customSpeed / 10) * (deltaTime * 60))
        end
    end
end)

-- 2. SPIN BOT
RunService.RenderStepped:Connect(function()
    if isSpinBotEnabled and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        player.Character.HumanoidRootPart.CFrame = player.Character.HumanoidRootPart.CFrame * CFrame.Angles(0, math.rad(50), 0)
    end
end)

-- 3. ESP (SEE THROUGH WALLS)
local function CreateESP(obj)
    if isESPEnabled and (obj.Name:find("Brain") or obj:FindFirstChild("ClickDetector")) then
        local box = Instance.new("Highlight")
        box.Parent = obj
        box.FillColor = Color3.fromRGB(0, 255, 255)
        box.OutlineColor = Color3.new(1, 1, 1)
        task.wait(5)
        box:Destroy()
    end
end
workspace.DescendantAdded:Connect(CreateESP)

-- 4. FIX: AUTO-STEAL (Aggressive Search)
task.spawn(function()
    while task.wait(0.5) do
        if isAutoGrabEnabled and player.Character then
            for _, v in pairs(workspace:GetDescendants()) do
                if v.Name:lower():find("brain") or v:IsA("ClickDetector") or v:IsA("ProximityPrompt") then
                    local root = player.Character:FindFirstChild("HumanoidRootPart")
                    if root and (v:GetPivot().Position - root.Position).Magnitude < 30 then
                        task.wait(0.1) -- Fast grab
                        if v:IsA("ClickDetector") then fireclickdetector(v)
                        elseif v:IsA("ProximityPrompt") then fireproximityprompt(v)
                        elseif v.Parent:FindFirstChildOfClass("ClickDetector") then
                            fireclickdetector(v.Parent:FindFirstChildOfClass("ClickDetector"))
                        end
                    end
                end
            end
        end
    end
end)

-- UI BUTTON GENERATOR
local offset = 60
local function AddToggle(name, varName, callback)
    local btn = Instance.new("TextButton", MainFrame)
    btn.Size = UDim2.new(0.8, 0, 0, 35)
    btn.Position = UDim2.new(0.1, 0, 0, offset)
    btn.Text = name .. ": OFF"
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    btn.TextColor3 = Color3.new(1, 1, 1)
    Instance.new("UICorner", btn)
    
    btn.MouseButton1Click:Connect(function()
        _G[varName] = not _G[varName]
        callback(_G[varName])
        btn.Text = name .. (_G[varName] and ": ON" or ": OFF")
        btn.BackgroundColor3 = _G[varName] and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(30, 30, 30)
    end)
    offset = offset + 45
end

AddToggle("Speed Boost", "sb", function(v) isSpeedEnabled = v end)
AddToggle("Spin Bot", "spin", function(v) isSpinBotEnabled = v end)
AddToggle("Brain ESP", "esp", function(v) isESPEnabled = v end)
AddToggle("Auto Steal", "steal", function(v) isAutoGrabEnabled = v end)

