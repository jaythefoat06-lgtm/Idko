-- [[ FIXED SLIDER WITH CIRCLE ]] --
local function AddSlider(name, y, min, max, default, var)
    local F = Instance.new("Frame", Main)
    F.Size = UDim2.new(0.9, 0, 0, 40)
    F.Position = UDim2.new(0.05, 0, 0, y)
    F.BackgroundTransparency = 1
    
    local L = Instance.new("TextLabel", F)
    L.Text = name .. ": " .. default
    L.Size = UDim2.new(1, 0, 0, 15)
    L.TextColor3 = Color3.new(1,1,1)
    L.BackgroundTransparency = 1
    L.Font = Enum.Font.Gotham
    L.TextSize = 12

    local BG = Instance.new("TextButton", F) -- Button for better click detection
    BG.Size = UDim2.new(1, 0, 0, 4)
    BG.Position = UDim2.new(0, 0, 1, -10)
    BG.BackgroundColor3 = Color3.fromRGB(60, 20, 60)
    BG.Text = ""
    Instance.new("UICorner", BG)

    local Fill = Instance.new("Frame", BG)
    Fill.Size = UDim2.new((default - min)/(max - min), 0, 1, 0)
    Fill.BackgroundColor3 = Color3.fromRGB(255, 20, 147)
    Instance.new("UICorner", Fill)

    local Knob = Instance.new("Frame", Fill)
    Knob.Size = UDim2.new(0, 12, 0, 12)
    Knob.Position = UDim2.new(1, -6, 0.5, -6)
    Knob.BackgroundColor3 = Color3.new(1, 1, 1)
    Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)
    Instance.new("UIStroke", Knob).Color = Color3.fromRGB(255, 20, 147)

    local function Update()
        local MousePos = UIS:GetMouseLocation().X
        local BtnPos = BG.AbsolutePosition.X
        local BtnSize = BG.AbsoluteSize.X
        local Percentage = math.clamp((MousePos - BtnPos) / BtnSize, 0, 1)
        
        Fill.Size = UDim2.new(Percentage, 0, 1, 0)
        local Value = math.floor(min + (Percentage * (max - min)))
        L.Text = name .. ": " .. Value
        _G.Settings[var] = Value
    end

    local Connection;
    BG.MouseButton1Down:Connect(function()
        Update()
        Connection = RS.RenderStepped:Connect(Update)
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 and Connection then
            Connection:Disconnect()
        end
    end)
end

-- [[ TOGGLE ]] --
local function AddToggle(name, y, var)
    local F = Instance.new("Frame", Main)
    F.Size = UDim2.new(0.9, 0, 0, 30)
    F.Position = UDim2.new(0.05, 0, 0, y)
    F.BackgroundTransparency = 1
    
    local L = Instance.new("TextLabel", F)
    L.Text = name
    L.Size = UDim2.new(0.6, 0, 1, 0)
    L.TextColor3 = Color3.fromRGB(255, 180, 230)
    L.BackgroundTransparency = 1
    L.TextXAlignment = Enum.TextXAlignment.Left
    L.Font = Enum.Font.Gotham
    L.TextSize = 14

    local B = Instance.new("TextButton", F)
    B.Size = UDim2.new(0, 38, 0, 18)
    B.Position = UDim2.new(1, -40, 0.5, -9)
    B.BackgroundColor3 = Color3.fromRGB(60, 20, 60)
    B.Text = ""
    Instance.new("UICorner", B).CornerRadius = UDim.new(1, 0)
    
    local Dot = Instance.new("Frame", B)
    Dot.Size = UDim2.new(0, 14, 0, 14)
    Dot.Position = UDim2.new(0, 2, 0.5, -7)
    Dot.BackgroundColor3 = Color3.new(1, 1, 1)
    Instance.new("UICorner", Dot).CornerRadius = UDim.new(1, 0)

    B.MouseButton1Click:Connect(function()
        _G.Settings[var] = not _G.Settings[var]
        B.BackgroundColor3 = _G.Settings[var] and Color3.fromRGB(255, 20, 147) or Color3.fromRGB(60, 20, 60)
        Dot:TweenPosition(_G.Settings[var] and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7), "Out", "Quad", 0.2)
    end)
end

