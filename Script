local function updateFilterValue()
    local newValue = parseNumber(ValueInput.Text)
    State.MinGenFilter = newValue
    
    local displayValue = newValue / 1e6
    if displayValue == math.floor(displayValue) then
        ValueInput.Text = tostring(math.floor(displayValue))
    else
        ValueInput.Text = formatNumber(newValue)
    end
    
    saveFilterValue(newValue)
    
    local itemsToRemove = {}
    for i, item in ipairs(State.DisplayedItems) do
        if item.valor < State.MinGenFilter then
            if item.frame and item.frame.Parent then
                item.frame:Destroy()
            end
            table.insert(itemsToRemove, i)
        end
    end
    
    for i = #itemsToRemove, 1, -1 do
        table.remove(State.DisplayedItems, itemsToRemove[i])
    end
end

ValueInput.FocusLost:Connect(function(enterPressed)
    updateFilterValue()
end)

