end

-- [[ STEALTH CORE LOGIC ]] --
RS.Heartbeat:Connect(function()
    local Char = LP.Character
    local Hum = Char and Char:FindFirstChildOfClass("Humanoid")
    local Root = Char and Char:FindFirstChild("HumanoidRootPart")

    if Hum and Root then
        -- FIXED SPEED
        Hum.WalkSpeed = _G.Settings.SpeedActive and _G.Settings.WalkSpeed or 16
        
        -- PHYSICAL SPIN (Prevents Resetting)
        if _G.Settings.SpinActive then
            local BodyAng = Root:FindFirstChild("8Hub_SpinForce") or Instance.new("BodyAngularVelocity", Root)
            BodyAng.Name = "8Hub_SpinForce"
            BodyAng.MaxTorque = Vector3.new(0, math.huge, 0)
            BodyAng.AngularVelocity = Vector3.new(0, _G.Settings.SpinSpeed, 0)
        elseif Root:FindFirstChild("8Hub_SpinForce") then
            Root:FindFirstChild("8Hub_SpinForce"):Destroy()
        end

        -- STEALTH ANTI-KB
        if _G.Settings.AntiKB and Root.AssemblyLinearVelocity.Magnitude > Hum.WalkSpeed + 5 then
            Root.AssemblyLinearVelocity = Vector3.new(0, Root.AssemblyLinearVelocity.Y, 0)
        end

        -- VISUAL AUTO-GRAB (Nearby Only)
        if _G.Settings.AutoGrab then
            for _, v in pairs(workspace:GetDescendants()) do
                if v:IsA("TouchTransmitter") then
                    local parent = v.Parent
                    local dist = (Root.Position - parent.Position).Magnitude
                    if dist <= 15 then
                        if not parent:FindFirstChildOfClass("BillboardGui") then
                            CreateCollectUI(parent)
                        end
                        firetouchinterest(Root, parent, 0)
                        firetouchinterest(Root, parent, 1)
                    elseif parent:FindFirstChildOfClass("BillboardGui") then
                        parent:FindFirstChildOfClass("BillboardGui"):Destroy()
                    end
                end
            end
        end
    end
end)

-- STEALTH JUMP (Soft Force)
