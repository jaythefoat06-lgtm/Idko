-- Submit function
local function checkKey()
    local enteredKey = keyInput.Text:gsub("%s+", "") -- Remove spaces
    
    if enteredKey == CORRECT_KEY then
        keyAuthorized = true
        keyStatus.Text = "✅ ACCESS GRANTED!"
        keyStatus.TextColor3 = Color3.fromRGB(34, 197, 94)
        keySubmit.BackgroundColor3 = Color3.fromRGB(34, 197, 94)
        keySubmit.Text = "LOADING..."
        
        task.wait(1)
        keyGui:Destroy()
        
        -- Continue loading main script
        loadMainScript()
    else
        keyAttempts = keyAttempts + 1
        local remaining = maxAttempts - keyAttempts
        
        if remaining <= 0 then
            keyStatus.Text = "❌ TOO MANY ATTEMPTS!"
            keyStatus.TextColor3 = Color3.fromRGB(239, 68, 68)
            keySubmit.BackgroundColor3 = Color3.fromRGB(239, 68, 68)
            keySubmit.Text = "LOCKED"
            keySubmit.Active = false
            keyAttemptsLabel.Text = "Script locked - restart to try again"
            
            -- Disable input
            keyInput.Active = false
            keyInput.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
        else
            keyStatus.Text = "❌ INCORRECT KEY!"
            keyStatus.TextColor3 = Color3.fromRGB(239, 68, 68)
            keyAttemptsLabel.Text = "Attempts remaining: " .. remaining
            keyInput.Text = ""
        end
    end
end

