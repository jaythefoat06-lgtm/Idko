-- [[ SETTINGS & TOGGLES ]] --
_G.Settings = {
    Speed = 50,
    Spin = false,
    InfJump = false,
    AntiKB = false,
    AutoGrab = false
}

local function CreateToggle(name, yPos, varName)
    local Btn = Instance.new("TextButton", Main)
    Btn.Size = UDim2.new(0.8, 0, 0, 40)
    Btn.Position = UDim2.new(0.1, 0, 0, yPos)
    Btn.BackgroundColor3 = Color3.fromRGB(50, 0, 50)
    Btn.Text = name .. ": OFF"
    Btn.TextColor3 = Color3.new(1, 1, 1)
    Btn.Font = Enum.Font.Gotham
    Instance.new("UICorner", Btn)
    
    Btn.MouseButton1Click:Connect(function()
        _G.Settings[varName] = not _G.Settings[varName]
        Btn.Text = name .. ": " .. (_G.Settings[varName] and "ON" or "OFF")
        Btn.BackgroundColor3 = _G.Settings[varName] and Color3.fromRGB(255, 20, 147) or Color3.fromRGB(50, 0, 50)
    end)
end

CreateToggle("Speed Boost", 70, "SpeedEnabled") -- Just added a check for this
CreateToggle("Spin Bot", 120, "Spin")
CreateToggle("Infinite Jump", 170, "InfJump")
CreateToggle("Anti-Knockback", 220, "AntiKB")
CreateToggle("Auto-Grab Items", 270, "AutoGrab")

-- [[ LOGIC ]] --
RS.Heartbeat:Connect(function()
    local Char = LP.Character
    local Root = Char and Char:FindFirstChild("HumanoidRootPart")
    local Hum = Char and Char:FindFirstChildOfClass("Humanoid")

    if Root and Hum then
        -- Speed
        if _G.Settings.SpeedEnabled then Hum.WalkSpeed = _G.Settings.Speed else Hum.WalkSpeed = 16 end
        
        -- Spin
        if _G.Settings.Spin then
            Root.CFrame = Root.CFrame * CFrame.Angles(0, math.rad(25), 0)
        end
        
        -- Anti-KB
        if _G.Settings.AntiKB then
            Root.Velocity = Vector3.new(0, Root.Velocity.Y, 0)
        end
    end
    
    -- Auto Grab
    if _G.Settings.AutoGrab and Root then
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("TouchTransmitter") and (Root.Position - v.Parent.Position).Magnitude <= 30 then
                firetouchinterest(Root, v.Parent, 0)
                firetouchinterest(Root, v.Parent, 1)
            end
        end
    end
end)

UIS.JumpRequest:Connect(function()
    if _G.Settings.InfJump and LP.Character:FindFirstChildOfClass("Humanoid") then
        LP.Character:FindFirstChildOfClass("Humanoid"):ChangeState("Jumping")
    end
end)

