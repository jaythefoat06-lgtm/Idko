-- [[ TOGGLE COMPONENT ]]
local function CreateToggle(text, pos, varName)
    local btn = Instance.new("TextButton", MainFrame)
    btn.Size = UDim2.new(0.8, 0, 0, 40)
    btn.Position = pos
    btn.Text = text .. ": OFF"
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    btn.BackgroundTransparency = 0.2
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 13
    btn.ZIndex = 2
    Instance.new("UICorner", btn)

    btn.MouseButton1Click:Connect(function()
        state[varName] = not state[varName]
        btn.Text = text .. (state[varName] and ": ON" or ": OFF")
        btn.BackgroundColor3 = state[varName] and Color3.fromRGB(100, 0, 255) or Color3.fromRGB(30, 30, 35)
    end)
end

