-- [[ THE ENGINES ]]

-- SPEED ENGINE: Pivot-Nudge (Hardest to detect)
RunService.Heartbeat:Connect(function(dt)
    if state.speedEnabled and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        local hum = player.Character.Humanoid
        local root = player.Character.HumanoidRootPart
        if hum.MoveDirection.Magnitude > 0 then
            -- We push the character's coordinate frame slightly forward based on your slider
            root.CFrame = root.CFrame + (hum.MoveDirection * (state.speedValue / 20))
        end
    end
end)

-- SPIN ENGINE
RunService.RenderStepped:Connect(function()
    if state.spinEnabled and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        player.Character.HumanoidRootPart.CFrame *= CFrame.Angles(0, math.rad(state.spinSpeed), 0)
    end
end)

-- AUTO STEAL ENGINE
