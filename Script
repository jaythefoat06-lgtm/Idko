-- [[ STEALTH LOGIC ]]

-- Speed Logic (CFrame based to prevent death)
RunService.Heartbeat:Connect(function(dt)
    if state.speedEnabled and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        local hum = player.Character:FindFirstChild("Humanoid")
        local root = player.Character.HumanoidRootPart
        if hum and hum.MoveDirection.Magnitude > 0 then
            root.CFrame = root.CFrame + (hum.MoveDirection * (state.speedValue / 10) * (dt * 60))
        end
    end
end)

-- Auto Steal Logic (Optimized for 2026 detection)
task.spawn(function()
