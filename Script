-- [[ STEALTH CORE LOGIC ]] --
RS.Heartbeat:Connect(function()
    local Char = LP.Character
    local Hum = Char and Char:FindFirstChildOfClass("Humanoid")
    local Root = Char and Char:FindFirstChild("HumanoidRootPart")

    if Hum and Root then
        -- SPEED
        if _G.Settings.SpeedActive then Hum.WalkSpeed = _G.Settings.WalkSpeed else Hum.WalkSpeed = 16 end
        
        -- SPIN (Smooth CFrame Lerp)
        if _G.Settings.SpinActive then
            Root.CFrame = Root.CFrame * CFrame.Angles(0, math.rad(_G.Settings.SpinSpeed), 0)
        end

        -- FREEZE IDLE (Stops animations locally only)
        if _G.Settings.Freeze then
            for _, track in pairs(Hum:GetPlayingAnimationTracks()) do
                track:AdjustSpeed(0)
            end
        else
            for _, track in pairs(Hum:GetPlayingAnimationTracks()) do
                track:AdjustSpeed(1)
            end
        end

        -- ANTI-KB (Optimized to not slow you down)
        if _G.Settings.AntiKB then
            local vel = Root.AssemblyLinearVelocity
            if vel.Magnitude > Hum.WalkSpeed + 5 then -- Only triggers if hit by something fast
                Root.AssemblyLinearVelocity = Vector3.new(0, vel.Y, 0)
            end
        end
    end

    -- AUTO-GRAB (Touch interest trigger)
    if _G.Settings.AutoGrab and Root then
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("TouchTransmitter") and (Root.Position - v.Parent.Position).Magnitude <= 10 then
                firetouchinterest(Root, v.Parent, 0)
                firetouchinterest(Root, v.Parent, 1)
            end
        end
    end
end)

-- STEALTH JUMP (Applies a soft impulse instead of a state change)
UIS.JumpRequest:Connect(function()
    if _G.Settings.InfJump and LP.Character then
        local Root = LP.Character:FindFirstChild("HumanoidRootPart")
        if Root then
            Root.AssemblyLinearVelocity = Vector3.new(Root.AssemblyLinearVelocity.X, 50, Root.AssemblyLinearVelocity.Z)
        end
    end
end)
