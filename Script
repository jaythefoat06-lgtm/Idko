-- [[ SLIDER CREATOR ]]
local function CreateSlider(name, pos, min, max, varName)
    local Label = Instance.new("TextLabel", MainFrame)
    Label.Size = UDim2.new(0.8, 0, 0, 20)
    Label.Position = pos
    Label.Text = name .. ": " .. state[varName]
    Label.TextColor3 = Color3.new(1,1,1)
    Label.BackgroundTransparency = 1
    Label.ZIndex = 2

    local SliderBar = Instance.new("Frame", MainFrame)
    SliderBar.Size = UDim2.new(0.8, 0, 0, 6)
    SliderBar.Position = pos + UDim2.new(0, 0, 0, 25)
    SliderBar.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    SliderBar.ZIndex = 2
    
    local Fill = Instance.new("Frame", SliderBar)
    Fill.Size = UDim2.new((state[varName]-min)/(max-min), 0, 1, 0)
    Fill.BackgroundColor3 = Color3.fromRGB(100, 0, 255)

    local Button = Instance.new("TextButton", SliderBar)
    Button.Size = UDim2.new(1, 0, 1, 0)
    Button.BackgroundTransparency = 1
    Button.Text = ""

    Button.MouseButton1Down:Connect(function()
        local moveConnection
        moveConnection = RunService.RenderStepped:Connect(function()
            local mousePos = UserInputService:GetMouseLocation().X
            local relativePos = math.clamp((mousePos - SliderBar.AbsolutePosition.X) / SliderBar.AbsoluteSize.X, 0, 1)
            local value = math.floor(min + (relativePos * (max - min)))
            
            state[varName] = value
            Label.Text = name .. ": " .. value
            Fill.Size = UDim2.new(relativePos, 0, 1, 0)
        end)
        
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                if moveConnection then moveConnection:Disconnect() end
            end
        end)
    end)
end

-- [[ TOGGLE CREATOR ]]
local function CreateToggle(name, pos, varName)
    local btn = Instance.new("TextButton", MainFrame)
    btn.Size = UDim2.new(0.8, 0, 0, 35)
    btn.Position = pos
    btn.Text = name .. ": OFF"
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    btn.TextColor3 = Color3.new(1,1,1)
    btn.ZIndex = 2
    Instance.new("UICorner", btn)

    btn.MouseButton1Click:Connect(function()
        state[varName] = not state[varName]
        btn.Text = name .. (state[varName] and ": ON" or ": OFF")
        btn.BackgroundColor3 = state[varName] and Color3.fromRGB(100, 0, 255) or Color3.fromRGB(30, 30, 30)
    end)
end

