-- [[ COMPONENT CREATORS ]]
local function CreateToggle(text, pos, varName)
    local btn = Instance.new("TextButton", MainFrame)
    btn.Size = UDim2.new(0.4, 0, 0, 30)
    btn.Position = pos
    btn.Text = text
    btn.BackgroundColor3 = Color3.fromRGB(80, 0, 200)
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 12
    Instance.new("UICorner", btn)

    btn.MouseButton1Click:Connect(function()
        state[varName] = not state[varName]
        btn.BackgroundColor3 = state[varName] and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(80, 0, 200)
    end)
end

local function CreateSlider(text, pos, min, max, varName)
    local label = Instance.new("TextLabel", MainFrame)
    label.Size = UDim2.new(0.4, 0, 0, 15)
    label.Position = pos
    label.Text = text .. ": " .. state[varName]
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.new(0.8, 0.8, 0.8)
    label.Font = Enum.Font.Gotham
    label.TextSize = 10

    local bar = Instance.new("Frame", MainFrame)
    bar.Size = UDim2.new(0.4, 0, 0, 5)
    bar.Position = pos + UDim2.new(0, 0, 0, 18)
    bar.BackgroundColor3 = Color3.fromRGB(80, 0, 200)
    
    -- Basic slider logic could be added here for mouse movement
end

