-- [[ THE "UNDETECTABLE" LOGIC ]]

-- 1. Stealth Speed: Moves CFrame on Heartbeat (Post-Physics)
-- This avoids "Velocity" checks which cause the "killing" issue.
RunService.Heartbeat:Connect(function(dt)
    if state.speedEnabled and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        local hum = player.Character:FindFirstChild("Humanoid")
        local root = player.Character.HumanoidRootPart
        if hum and hum.MoveDirection.Magnitude > 0 then
            -- Moves you 1.5x - 2.5x normal speed without modifying WalkSpeed
            root.CFrame = root.CFrame + (hum.MoveDirection * (state.speedValue / 10) * (dt * 60))
        end
    end
end)

-- 2. Anti-Gravity Jump: Uses a BodyForce instead of JumpPower
-- This makes your jump look floaty and natural to the server.
RunService.RenderStepped:Connect(function()
    if state.jumpEnabled and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            player.Character.HumanoidRootPart.Velocity = Vector3.new(
                player.Character.HumanoidRootPart.Velocity.X,
                35, 
                player.Character.HumanoidRootPart.Velocity.Z
            )
        end
    end
end)

-- 3. Spin Bot
RunService.RenderStepped:Connect(function()
    if state.spinEnabled and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        player.Character.HumanoidRootPart.CFrame *= CFrame.Angles(0, math.rad(state.spinSpeed), 0)
    end
end)

-- 4. Auto Steal: Uses Raycast-Safe clicking
task.spawn(function()
    while task.wait(0.5) do
        if state.autoSteal and player.Character then
            for _, v in pairs(workspace:GetDescendants()) do
                if (v.Name:lower():find("brain") or v:IsA("ClickDetector") or v:IsA("ProximityPrompt")) then
                    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                    if hrp and (v:GetPivot().Position - hrp.Position).Magnitude < state.stealRange then
                        task.wait(3) -- HUMAN-LIKE DELAY
                        if v:IsA("ClickDetector") then 
                            fireclickdetector(v) 
                        elseif v:IsA("ProximityPrompt") then 
                            fireproximityprompt(v) 
                        end
                    end
                end
            end
        end
    end
end)

-- 5. ESP: Highlight items
RunService.Heartbeat:Connect(function()
    if state.espEnabled then
        for _, v in pairs(workspace:GetDescendants()) do
            if v.Name:lower():find("brain") and not v:FindFirstChild("Highlight") then
                local h = Instance.new("Highlight", v)
                h.FillColor = Color3.fromRGB(150, 0, 255)
                h.OutlineColor = Color3.new(1, 1, 1)
            end
        end
    end
end)

