-- [[ JAY HALFWAY TP ]] --
local Players = game:GetService("Players")
local LP = Players.LocalPlayer

_G.JaySettings = {
    Enabled = true,
    Distance = 5, -- How many studs away you stay
    Height = 2    -- Slight height offset to prevent clipping
}

local function JayHalfwayTP(TargetPlayerName)
    local Target = Players:FindFirstChild(TargetPlayerName)
    if Target and Target.Character and Target.Character:FindFirstChild("HumanoidRootPart") then
        local MyRoot = LP.Character:FindFirstChild("HumanoidRootPart")
        local TargetRoot = Target.Character.HumanoidRootPart
        
        if MyRoot and TargetRoot then
            -- Logic: Sets your position to the target's position, 
            -- but moved back by the Distance setting
            MyRoot.CFrame = TargetRoot.CFrame * CFrame.new(0, _G.JaySettings.Height, _G.JaySettings.Distance)
        end
    end
end

-- Example usage:
-- JayHalfwayTP("PlayerNameHere")
print("Jay Halfway TP Loaded")
