local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local player = Players.LocalPlayer

-- Config
local isSpeedEnabled, customSpeed = false, 30
local isInfJumpEnabled = false
local isAutoGrabEnabled = false

-- UI Setup
local ScreenGui = Instance.new("ScreenGui", game:GetService("CoreGui"))
local Frame = Instance.new("Frame", ScreenGui)
Frame.Size = UDim2.new(0, 220, 0, 200)
Frame.Position = UDim2.new(0.5, -110, 0.4, -100)
Frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
Frame.Active, Frame.Draggable = true, true

local Status = Instance.new("TextLabel", Frame)
Status.Size = UDim2.new(1, 0, 0, 50)
Status.Text = "SPD: OFF | JMP: OFF | GRAB: OFF"
Status.TextColor3 = Color3.new(1, 0, 0)
Status.BackgroundTransparency = 1

local Info = Instance.new("TextLabel", Frame)
Info.Size = UDim2.new(1, 0, 0, 80)
Info.Position = UDim2.new(0, 0, 0.6, 0)
Info.Text = "[G] Speed  [H] Jump  [J] Auto-Grab\nSet Speed below (20-100)"
Info.TextColor3 = Color3.new(0.8, 0.8, 0.8)
Info.TextSize = 12
Info.BackgroundTransparency = 1

local TextBox = Instance.new("TextBox", Frame)
TextBox.Size = UDim2.new(0.8, 0, 0.15, 0)
TextBox.Position = UDim2.new(0.1, 0, 0.3, 0)
TextBox.PlaceholderText = "30"

-- 1. STEALTH SPEED (Heartbeat Method)
RunService.Heartbeat:Connect(function(dt)
    if isSpeedEnabled and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        local hum = player.Character.Humanoid
        if hum.MoveDirection.Magnitude > 0 then
            player.Character.HumanoidRootPart.CFrame += hum.MoveDirection * (customSpeed - 16) * dt
        end
    end
end)

-- 2. INFINITE JUMP
UserInputService.JumpRequest:Connect(function()
    if isInfJumpEnabled and player.Character:FindFirstChildOfClass("Humanoid") then
        player.Character:FindFirstChildOfClass("Humanoid"):ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

-- 3. AUTO-GRAB BRAINROT (3-Second Delay Logic)
local function grabBrainrot(obj)
    if isAutoGrabEnabled and obj:IsA("Model") and (obj.Name:find("Brainrot") or obj:FindFirstChild("ClickDetector")) then
        task.wait(3) -- Your requested 3-second delay
        
        -- Check if it's still there and close enough
        local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        local click = obj:FindFirstChildOfClass("ClickDetector")
        
        if root and click and (obj:GetPivot().Position - root.Position).Magnitude < 20 then
            fireclickdetector(click) -- Standard executor function
        end
    end
end

-- Watch for new Brainrots spawning
workspace.DescendantAdded:Connect(grabBrainrot)

-- Keybinds
UserInputService.InputBegan:Connect(function(input, proc)
    if proc then return end
    if input.KeyCode == Enum.KeyCode.G then isSpeedEnabled = not isSpeedEnabled
    elseif input.KeyCode == Enum.KeyCode.H then isInfJumpEnabled = not isInfJumpEnabled
    elseif input.KeyCode == Enum.KeyCode.J then isAutoGrabEnabled = not isAutoGrabEnabled end
    
    local s = isSpeedEnabled and "ON" or "OFF"
    local j = isInfJumpEnabled and "ON" or "OFF"
    local g = isAutoGrabEnabled and "ON" or "OFF"
    Status.Text = string.format("SPD: %s | JMP: %s | GRAB: %s", s, j, g)
    Status.TextColor3 = (isSpeedEnabled or isInfJumpEnabled or isAutoGrabEnabled) and Color3.new(0, 1, 0) or Color3.new(1, 0, 0)
end)

TextBox.FocusLost:Connect(function()
    customSpeed = math.clamp(tonumber(TextBox.Text) or 30, 20, 100)
    TextBox.Text = "Set to " .. customSpeed
end)
