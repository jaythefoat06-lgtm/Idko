-- [[ FUNCTIONAL ENGINES ]]

-- Stealth Speed (Fixed to bypass velocity-based anti-cheats)
RunService.Stepped:Connect(function(_, dt)
    if state.speedBoost and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        local hum = player.Character.Humanoid
        local root = player.Character.HumanoidRootPart
        if hum.MoveDirection.Magnitude > 0 then
            -- Moves the CFrame directly to avoid high velocity spikes
            root.CFrame = root.CFrame + (hum.MoveDirection * (state.boostSpeed / 10) * (dt * 60))
        end
    end
end)

-- Spin Bot Logic
RunService.RenderStepped:Connect(function()
    if state.spinBot and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        player.Character.HumanoidRootPart.CFrame *= CFrame.Angles(0, math.rad(state.spinSpeed), 0)
    end
end)

-- Auto Steal (3-second delay included)
task.spawn(function()
    while task.wait(0.5) do
        if state.autoSteal and player.Character then
            for _, v in pairs(workspace:GetDescendants()) do
                if v.Name:lower():find("brain") or v:IsA("ClickDetector") or v:IsA("ProximityPrompt") then
                    local root = player.Character:FindFirstChild("HumanoidRootPart")
                    if root and (v:GetPivot().Position - root.Position).Magnitude < 30 then
                        task.wait(3) 
                        if v:IsA("ClickDetector") then fireclickdetector(v)
                        elseif v:IsA("ProximityPrompt") then fireproximityprompt(v) end
                    end
                end
            end
        end
    end
end)

-- Xray / ESP
local function ApplyESP()
    if state.optimizerXray then
        for _, v in pairs(workspace:GetDescendants()) do
            if v.Name:lower():find("brain") and not v:FindFirstChild("Highlight") then
                local h = Instance.new("Highlight", v)
                h.FillColor = Color3.fromRGB(150, 0, 255)
                h.OutlineColor = Color3.new(1, 1, 1)
            end
        end
    end
end
RunService.Heartbeat:Connect(ApplyESP)

