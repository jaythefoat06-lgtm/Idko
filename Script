-- [[ FIXED LOGIC ]] --
RS.Heartbeat:Connect(function()
    local Char = LP.Character
    local Hum = Char and Char:FindFirstChildOfClass("Humanoid")
    local Root = Char and Char:FindFirstChild("HumanoidRootPart")

    if Hum and Root then
        -- FIXED ANTI-KB (Zeros Velocity without freezing player movement)
        if _G.Settings.AntiKB then
            local oldVel = Root.Velocity
            Root.Velocity = Vector3.new(0, oldVel.Y, 0)
            Root.RotVelocity = Vector3.new(0, 0, 0)
        end

        -- SPEED
        if _G.Settings.SpeedActive then Hum.WalkSpeed = _G.Settings.WalkSpeed else Hum.WalkSpeed = 16 end
        
        -- UNDETECTED SPIN (Uses CFrame Lerp for smoothness)
        if _G.Settings.SpinActive then
            Root.CFrame = Root.CFrame * CFrame.Angles(0, math.rad(_G.Settings.SpinSpeed), 0)
        end
    end

    -- AUTO-GRAB (Nearby focus)
    if _G.Settings.AutoGrab and Root then
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("TouchTransmitter") and (Root.Position - v.Parent.Position).Magnitude <= 15 then
                firetouchinterest(Root, v.Parent, 0)
                firetouchinterest(Root, v.Parent, 1)
            end
        end
    end
end)

-- UNDETECTED INF JUMP
