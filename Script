    -- ================================================================
    -- FIXED UNDETECTABLE FLOAT MODE
    -- ================================================================
    local floatConnection = nil
    local floatTargetHeight = 0
    local floatEnabled = false
    local floatJitter = 0

    local function startFloat()
        if floatConnection then return end
        
        floatEnabled = true
        
        floatConnection = RunService.Heartbeat:Connect(function()
            if not Enabled.Float then return end
            
            local c = Player.Character
            if not c then return end
            
            local hrp = c:FindFirstChild("HumanoidRootPart")
            local hum = c:FindFirstChildOfClass("Humanoid")
            
            if not hrp or not hum then return end
            if hum.Health <= 0 then return end
            
            local raycastParams = RaycastParams.new()
            raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
            raycastParams.FilterDescendantsInstances = {c}
            
            local rayOrigin = hrp.Position
            local rayDirection = Vector3.new(0, -100, 0)
            
            local rayResult = workspace:Raycast(rayOrigin, rayDirection, raycastParams)
            
            if rayResult then
                floatTargetHeight = rayResult.Position.Y + Values.FloatHeight
                floatJitter = math.sin(tick() * 3) * 0.3
                
                local currentY = hrp.Position.Y
                local diff = (floatTargetHeight + floatJitter) - currentY
                
                if math.abs(diff) > 0.1 then
                    local velocity = hrp.AssemblyLinearVelocity
                    local force = diff * Values.FloatStrength * 10
                    force = math.clamp(force, -30, 30)
                    
                    hrp.AssemblyLinearVelocity = Vector3.new(
                        velocity.X,
                        velocity.Y * 0.8 + force,
                        velocity.Z
                    )
                end
            else
                local velocity = hrp.AssemblyLinearVelocity
                hrp.AssemblyLinearVelocity = Vector3.new(
                    velocity.X,
                    velocity.Y * 0.95,
                    velocity.Z
                )
            end
            
            if math.random() < 0.05 then
                local velocity = hrp.AssemblyLinearVelocity
                hrp.AssemblyLinearVelocity = Vector3.new(
                    velocity.X,
                    velocity.Y + (math.random() - 0.5) * 0.5,
                    velocity.Z
                )
            end
        end)
    end

    local function stopFloat()
        floatEnabled = false
        if floatConnection then
