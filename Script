end)

-- Base Defense button functionality
baseDefenseButton.MouseButton1Click:Connect(function()
    if selectedPlayer then
        -- Send the balloon command in chat
        local chatMessage = ";balloon @" .. selectedPlayer.Name
        ReplicatedStorage.DefaultChatSystemChatEvents.SayMessageRequest:FireServer(chatMessage, "All")
        
        -- Visual feedback
        baseDefenseButton.Text = "🎈 Balloon Deployed!"
        wait(1)
        baseDefenseButton.Text = "🎈 Base Defense"
        
        -- Optional: Show notification
        LocalPlayer.PlayerGui:FindFirstChild("BrainrotStealer"):Destroy()
    else
        -- Shake effect to indicate no selection
        local originalPos = mainFrame.Position
        for i = 1, 3 do
            mainFrame.Position = originalPos + UDim2.new(0, 5, 0, 0)
            wait(0.05)
            mainFrame.Position = originalPos - UDim2.new(0, 5, 0, 0)
            wait(0.05)
            mainFrame.Position = originalPos
        end
        
        selectedLabel.Text = "⚠️ Please select a player first!"
        wait(2)
        selectedLabel.Text = selectedPlayer and "Selected: " .. selectedPlayer.DisplayName or "No player selected"
    end
end)

