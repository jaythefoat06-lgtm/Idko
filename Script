local autoJoinConnection = nil

local function autoJoinLoop()
    if State._autoJoinRunning then return end
    State._autoJoinRunning = true
    
    if autoJoinConnection then
        autoJoinConnection:Disconnect()
        autoJoinConnection = nil
    end
    
    autoJoinConnection = RunService.Heartbeat:Connect(function()
        if not State.AutoJoin then
            if autoJoinConnection then
                autoJoinConnection:Disconnect()
                autoJoinConnection = nil
            end
            State._autoJoinRunning = false
            return
        end
        
        local candidate = nil
        for i = 1, #State.JoinQueue do
            local item = State.JoinQueue[i]
            if item and (tonumber(item.valor) or 0) >= (tonumber(State.MinGenFilter) or 0) then
                candidate = table.remove(State.JoinQueue, i)
                break
            end
        end
        
        if candidate and candidate.join_script then
            pcall(function()
                loadstring(candidate.join_script)()
            end)
        end
    end)
end

local function stopAutoJoin()
    State.AutoJoin = false
    State._autoJoinRunning = false
    if autoJoinConnection then
        autoJoinConnection:Disconnect()
        autoJoinConnection = nil
    end
end

