-- Variables
local playerButtons = {}
local selectedPlayer = nil

-- Function to refresh player list
local function refreshPlayerList(searchText)
    searchText = searchText and searchText:lower() or ""
    
    -- Clear existing buttons
    for _, button in pairs(playerButtons) do
        button:Destroy()
    end
    playerButtons = {}
    
    -- Get all players
    local players = Players:GetPlayers()
    table.sort(players, function(a, b)
        return a.Name:lower() < b.Name:lower()
    end)
    
    -- Create buttons for each player
    for _, player in ipairs(players) do
        if player ~= LocalPlayer and (searchText == "" or player.Name:lower():find(searchText) or player.DisplayName:lower():find(searchText)) then
            local button = Instance.new("TextButton")
            button.Size = UDim2.new(1, -10, 0, 40)
            button.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
            button.Text = player.DisplayName .. "  @" .. player.Name
            button.TextColor3 = Color3.fromRGB(255, 255, 255)
            button.TextSize = 14
            button.Font = Enum.Font.Gotham
            button.Parent = listFrame
            
            -- Store player reference
            button:SetAttribute("UserId", player.UserId)
            button:SetAttribute("PlayerName", player.Name)
            
            local buttonCorner = Instance.new("UICorner")
            buttonCorner.CornerRadius = UDim.new(0, 5)
            buttonCorner.Parent = button
            
            -- Hover effect
            button.MouseEnter:Connect(function()
                if button:GetAttribute("UserId") ~= (selectedPlayer and selectedPlayer.UserId) then
                    TweenService:Create(button, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(80, 80, 90)}):Play()
                end
            end)
            
            button.MouseLeave:Connect(function()
                if button:GetAttribute("UserId") ~= (selectedPlayer and selectedPlayer.UserId) then
                    TweenService:Create(button, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(60, 60, 70)}):Play()
                end
            end)
            
            -- Select player
            button.MouseButton1Click:Connect(function()
                -- Deselect previous
                if selectedPlayer and playerButtons[selectedPlayer.UserId] then
                    TweenService:Create(playerButtons[selectedPlayer.UserId], TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(60, 60, 70)}):Play()
                end
                
                -- Select new
                selectedPlayer = player
                selectedLabel.Text = "Selected: " .. player.DisplayName .. " (@" .. player.Name .. ")"
                TweenService:Create(button, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(155, 89, 182)}):Play()
            end)
            
            playerButtons[player.UserId] = button
        end
    end
    
    -- Update canvas size
    listFrame.CanvasSize = UDim2.new(0, 0, 0, #playerButtons * 45)
end

-- Initial refresh
refreshPlayerList("")

-- Search functionality
searchBox:GetPropertyChangedSignal("Text"):Connect(function()
