-- [[ GAME LOGIC ]] --
RS.Heartbeat:Connect(function()
    local Char = LP.Character
    local Hum = Char and Char:FindFirstChildOfClass("Humanoid")
    local Root = Char and Char:FindFirstChild("HumanoidRootPart")
    if Hum and Root then
        if _G.Settings.SpeedActive then Hum.WalkSpeed = _G.Settings.WalkSpeed else Hum.WalkSpeed = 16 end
        if _G.Settings.SpinActive then Root.CFrame = Root.CFrame * CFrame.Angles(0, math.rad(_G.Settings.SpinSpeed), 0) end
        if _G.Settings.AntiKB then Root.Velocity = Vector3.new(0, Root.Velocity.Y, 0) end
        if _G.Settings.Freeze then for _, v in pairs(Hum:GetPlayingAnimationTracks()) do v:Stop() end end
    end
end)

UIS.JumpRequest:Connect(function()
    if _G.Settings.InfJump and LP.Character:FindFirstChildOfClass("Humanoid") then
        LP.Character:FindFirstChildOfClass("Humanoid"):ChangeState("Jumping")
    end
end)
